{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and balance",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "balance": { "type": "number", "description": "Current available cash balance" }
      },
      "required": ["uid", "email", "balance"]
    },
    "TeamStock": {
      "title": "NFL Team Stock",
      "description": "Market data for a specific NFL team",
      "type": "object",
      "properties": {
        "symbol": { "type": "string", "description": "Team abbreviation e.g., MIN" },
        "name": { "type": "string" },
        "marketCap": { "type": "number" },
        "price": { "type": "number" },
        "prevPrice": { "type": "number" },
        "change": { "type": "number" },
        "changePercent": { "type": "number" }
      },
      "required": ["symbol", "name", "price"]
    },
    "PortfolioItem": {
      "title": "User Portfolio Item",
      "description": "Shares of a team stock owned by a user",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "shares": { "type": "number" },
        "avgPrice": { "type": "number" }
      },
      "required": ["teamId", "shares", "avgPrice"]
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "Buy, sell, deposit, or withdrawal event",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["buy", "sell", "deposit", "withdraw"] },
        "assetId": { "type": "string" },
        "amount": { "type": "number" },
        "shares": { "type": "number" },
        "price": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "timestamp"]
    },
    "FanCardRequest": {
      "title": "Fan Card Inquiry",
      "description": "Request for a physical or premium fan card",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "teamId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "responded", "fulfilled"] },
        "contactMethod": { "type": "string" },
        "message": { "type": "string" },
        "replies": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sender": { "type": "string" },
              "text": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "teamId", "status"]
    },
    "StoreOrder": {
      "title": "Store Purchase",
      "description": "Order for tickets or jerseys",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "itemType": { "type": "string", "enum": ["ticket", "jersey", "membership"] },
        "itemName": { "type": "string" },
        "price": { "type": "number" },
        "teamId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "itemType", "price", "timestamp"]
    },
    "TicketOrder": {
      "title": "Box Office Match Ticket Order",
      "description": "User ticket purchase order for NFL matches",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "gameId": { "type": "string" },
        "gameName": { "type": "string" },
        "homeTeam": { "type": "string" },
        "awayTeam": { "type": "string" },
        "stadium": { "type": "string" },
        "city": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "tier": { "type": "string" },
        "quantity": { "type": "number" },
        "pricePerTicket": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "buyerName": { "type": "string" },
        "buyerEmail": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["orderId", "gameId", "buyerEmail", "totalAmount"]
    },
    "Experience": {
      "title": "NFL Experience Product",
      "description": "Premium Tours, Player Meet & Greets, and Luxury Packages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["stadium_tour", "meet_greet", "private_tour"] },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "teamId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "player": { "type": "string" },
        "location": { "type": "string" },
        "dates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timeSlots": {
          "type": "array",
          "items": { "type": "string" }
        },
        "features": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" }
      },
      "required": ["title", "type", "category", "price", "teamId"]
    },
    "ExperienceBooking": {
      "title": "Experience Booking",
      "description": "User reservation for an NFL Experience",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "experienceId": { "type": "string" },
        "experienceTitle": { "type": "string" },
        "experienceType": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "guestsCount": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "completed", "cancelled"] },
        "qrCode": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "experienceId", "experienceTitle", "date", "timeSlot", "guestsCount", "totalPrice", "status"]
    },
    "PromoBanner": {
      "title": "Promotional Active Banner",
      "description": "Rotating advertisement configurations for landing page sliders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "imageUrl": { "type": "string" },
        "linkTab": { "type": "string" },
        "targetId": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "imageUrl", "isActive"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "users/{userId}/portfolio/{teamId}": {
      "schema": "PortfolioItem",
      "description": "User's current stock positions"
    },
    "users/{userId}/transactions/{txId}": {
      "schema": "Transaction",
      "description": "User's transaction history"
    },
    "teams/{teamId}": {
      "schema": "TeamStock",
      "description": "Live market data for NFL teams"
    },
    "fan_card_requests/{requestId}": {
      "schema": "FanCardRequest",
      "description": "User inquiries for fan cards"
    },
    "store_orders/{orderId}": {
      "schema": "StoreOrder",
      "description": "Global log of store purchases"
    },
    "ticket_orders/{orderId}": {
      "schema": "TicketOrder",
      "description": "User match ticket purchases"
    },
    "global_transactions/{txId}": {
      "schema": "Transaction",
      "description": "Global log of all financial events for admin auditing"
    },
    "experiences/{experienceId}": {
      "schema": "Experience",
      "description": "Global experiences and tours"
    },
    "bookings/{bookingId}": {
      "schema": "ExperienceBooking",
      "description": "User experience bookings and tickets"
    },
    "promo_banners/{bannerId}": {
      "schema": "PromoBanner",
      "description": "Admin promotional banners"
    },
    "players/{playerId}": {
      "schema": {
        "title": "NFL Player",
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "teamId": { "type": "string" },
          "position": { "type": "string" },
          "jerseyNumber": { "type": "string" },
          "description": { "type": "string" },
          "photoUrl": { "type": "string" },
          "createdAt": { "type": "number" },
          "updatedAt": { "type": "number" }
        },
        "required": ["name", "teamId"]
      },
      "description": "Featured NFL players for giveaways"
    },
    "giveaways/{giveawayId}": {
      "schema": {
        "title": "Player Giveaway Campaign",
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "playerId": { "type": "string" },
          "playerName": { "type": "string" },
          "teamId": { "type": "string" },
          "heroImageUrl": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "eligibility": { "type": "string" },
          "entryRequirements": { "type": "string" },
          "numWinners": { "type": "number" },
          "rules": { "type": "string" },
          "status": { "type": "string", "enum": ["DRAFT", "SCHEDULED", "ACTIVE", "ENDED", "ARCHIVED"] },
          "entriesCount": { "type": "number" },
          "prizes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "quantity": { "type": "number" },
                "imageUrl": { "type": "string" }
              }
            }
          }
        },
        "required": ["title", "playerId", "teamId", "status"]
      },
      "description": "Player giveaway campaigns"
    },
    "registered_fans/{fanId}": {
      "schema": {
        "title": "Registered Fan Profile",
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "fullName": { "type": "string" },
          "email": { "type": "string" },
          "city": { "type": "string" },
          "favoriteTeam": { "type": "string" },
          "profilePhotoUrl": { "type": "string" },
          "fanCode": { "type": "string" },
          "createdAt": { "type": "number" }
        },
        "required": ["fullName", "email", "favoriteTeam", "fanCode"]
      },
      "description": "Registered fans and virtual fan cards"
    },
    "giveaway_entries/{entryId}": {
      "schema": {
        "title": "Giveaway Entry Record",
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "giveawayId": { "type": "string" },
          "giveawayTitle": { "type": "string" },
          "playerId": { "type": "string" },
          "playerName": { "type": "string" },
          "teamId": { "type": "string" },
          "userId": { "type": "string" },
          "userEmail": { "type": "string" },
          "userName": { "type": "string" },
          "fanCode": { "type": "string" },
          "city": { "type": "string" },
          "profilePhotoUrl": { "type": "string" },
          "status": { "type": "string", "enum": ["ENTERED", "ELIGIBLE", "WINNER", "RUNNER_UP"] },
          "entryDate": { "type": "number" }
        },
        "required": ["giveawayId", "fanCode", "entryDate"]
      },
      "description": "User giveaway entries"
    },
    "giveaway_winners/{winnerId}": {
      "schema": {
        "title": "Giveaway Winner Record",
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "giveawayId": { "type": "string" },
          "giveawayTitle": { "type": "string" },
          "playerId": { "type": "string" },
          "playerName": { "type": "string" },
          "prizeName": { "type": "string" },
          "winnerUserId": { "type": "string" },
          "winnerFanCode": { "type": "string" },
          "winnerName": { "type": "string" },
          "winnerEmail": { "type": "string" },
          "selectionDate": { "type": "number" },
          "status": { "type": "string" }
        },
        "required": ["giveawayId", "winnerFanCode", "winnerName"]
      },
      "description": "Selected giveaway winners"
    },
    "teams_config/{teamId}": {
      "schema": {
        "title": "Team Branding Configuration",
        "type": "object",
        "properties": {
          "teamId": { "type": "string" },
          "teamName": { "type": "string" },
          "teamLogoUrl": { "type": "string" },
          "primaryColor": { "type": "string" },
          "secondaryColor": { "type": "string" },
          "fanCardTemplateStyle": { "type": "string" }
        },
        "required": ["teamId"]
      },
      "description": "Team template & branding configurations"
    },
    "admins/{userId}": {
      "schema": {
        "title": "Admin Record",
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "role": { "type": "string" }
        },
        "required": ["email"]
      },
      "description": "Authorized administrators"
    }
  }
}
