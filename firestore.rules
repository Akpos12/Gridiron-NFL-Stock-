rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'alexwtchmn@gmail.com')
      );
    }

    // Admin Rules
    match /admins/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Portfolio Rules
    match /users/{userId}/portfolio/{teamId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Transaction Rules
    match /users/{userId}/transactions/{txId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Global Transaction Log
    match /global_transactions/{txId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Teams Rules
    match /teams/{teamId} {
      allow read, list: if true;
      allow write: if true;
    }

    // Fan Card Request & Inquiry Rules
    match /fan_card_requests/{requestId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /customer_inquiries/{inquiryId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Store Order Rules
    match /store_orders/{orderId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Ticket Orders Rules
    match /ticket_orders/{orderId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Connection Health Test
    match /test/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // NFL Experiences Rules
    match /experiences/{experienceId} {
      allow read, list: if true;
      allow write: if true;
    }

    // Event Bookings Rules
    match /bookings/{bookingId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Promo Banners Rules
    match /promo_banners/{bannerId} {
      allow read, list: if true;
      allow write: if true;
    }

    // Player Giveaway System Rules
    match /players/{playerId} {
      allow read, list: if true;
      allow write: if true;
    }

    match /giveaways/{giveawayId} {
      allow read, list: if true;
      allow write: if true;
    }

    match /registered_fans/{fanId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /giveaway_entries/{entryId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /giveaway_winners/{winnerId} {
      allow read, list: if true;
      allow write: if true;
    }

    match /teams_config/{teamId} {
      allow read, list: if true;
      allow write: if true;
    }

    match /payment_sessions/{sessionId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /control_room_payment_settings/{settingId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Site Visitor Analytics Rules
    function isValidSiteVisit(data) {
      return data.keys().hasOnly([
        'sessionId', 'visitorId', 'visitNumber', 'firstSeenAt', 'lastSeenAt',
        'dateKey', 'currentTab', 'tabsViewed', 'entryPath', 'lastPath',
        'referrer', 'deviceType', 'browser', 'os', 'screenSize',
        'timezone', 'language', 'isAuthenticated', 'userEmail', 'isAdmin'
      ])
      && data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 48
      && data.visitorId is string && data.visitorId.size() > 0 && data.visitorId.size() <= 48
      && data.visitNumber is number && data.visitNumber >= 1 && data.visitNumber <= 999999
      && data.firstSeenAt is number
      && data.lastSeenAt is number
      && data.dateKey is string && data.dateKey.size() <= 16
      && data.currentTab is string && data.currentTab.size() <= 40
      && data.tabsViewed is list && data.tabsViewed.size() <= 20
      && data.entryPath is string && data.entryPath.size() <= 180
      && data.lastPath is string && data.lastPath.size() <= 180
      && data.referrer is string && data.referrer.size() <= 120
      && data.deviceType in ['Mobile', 'Tablet', 'Desktop']
      && data.browser is string && data.browser.size() <= 40
      && data.os is string && data.os.size() <= 40
      && data.screenSize is string && data.screenSize.size() <= 24
      && data.timezone is string && data.timezone.size() <= 64
      && data.language is string && data.language.size() <= 24
      && data.isAuthenticated is bool
      && data.userEmail is string && data.userEmail.size() <= 120
      && data.isAdmin is bool;
    }

    match /site_visits/{sessionId} {
      allow read, list: if true;
      allow create, update: if sessionId.size() > 0 && sessionId.size() <= 48
        && isValidSiteVisit(request.resource.data)
        && request.resource.data.sessionId == sessionId;
      allow delete: if true;
    }

    // Charitable Allocations & Transfer Ledger (Boys & Girls Clubs of America Initiative)
    function isValidCharityRecord(data) {
      return data.keys().hasAll(['id', 'beneficiary', 'periodLabel', 'allocatedAmount', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'beneficiary', 'periodLabel', 'allocatedAmount', 'disbursedAmount',
          'status', 'transferMethod', 'transferReference', 'notes', 'recordedBy',
          'transferredAt', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.beneficiary is string && data.beneficiary.size() > 0 && data.beneficiary.size() <= 140
        && data.periodLabel is string && data.periodLabel.size() > 0 && data.periodLabel.size() <= 80
        && data.allocatedAmount is number && data.allocatedAmount >= 0 && data.allocatedAmount <= 1000000
        && data.status in ['earmarked', 'scheduled', 'transferred', 'verified']
        && data.createdAt is number;
    }

    match /charity_records/{recordId} {
      allow read, list: if true;
      allow create, update: if recordId.size() > 0 && recordId.size() <= 64
        && isValidCharityRecord(request.resource.data)
        && request.resource.data.id == recordId;
      allow delete: if true;
    }
  }
}


