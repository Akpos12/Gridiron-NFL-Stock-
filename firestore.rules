rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'alexwtchmn@gmail.com')
      );
    }

    // Admin Rules
    match /admins/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Portfolio Rules
    match /users/{userId}/portfolio/{teamId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Transaction Rules
    match /users/{userId}/transactions/{txId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Global Transaction Log
    match /global_transactions/{txId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Teams Rules
    match /teams/{teamId} {
      allow read, list: if true;
      allow write: if true;
    }

    // Fan Card Request & Inquiry Rules
    match /fan_card_requests/{requestId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /customer_inquiries/{inquiryId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Store Order Rules
    match /store_orders/{orderId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // NFL Experiences Rules
    match /experiences/{experienceId} {
      allow read, list: if true;
      allow write: if true;
    }

    // Event Bookings Rules
    match /bookings/{bookingId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Promo Banners Rules
    match /promo_banners/{bannerId} {
      allow read, list: if true;
      allow write: if true;
    }

    // Player Giveaway System Rules
    match /players/{playerId} {
      allow read, list: if true;
      allow write: if true;
    }

    match /giveaways/{giveawayId} {
      allow read, list: if true;
      allow write: if true;
    }

    match /registered_fans/{fanId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /giveaway_entries/{entryId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /giveaway_winners/{winnerId} {
      allow read, list: if true;
      allow write: if true;
    }

    match /teams_config/{teamId} {
      allow read, list: if true;
      allow write: if true;
    }
  }
}

